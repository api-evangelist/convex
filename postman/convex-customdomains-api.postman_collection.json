                      "name": "Create a custom domain",
                      "id": "4b304707-e6db-40fc-876f-6d8618f744a2",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "application/json"
                          },
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"domain\": \"<string>\",\n  \"request_destination\": \"convexCloud\"\n}",
                          "options": {
                            "raw": {
                              "headerFamily": "json",
                              "language": "json"
                            }
                          }
                        },
                        "url": {
                          "raw": "{{baseUrl}}/deployments/:deployment_name/custom_domains/create",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "deployments",
                            ":deployment_name",
                            "custom_domains",
                            "create"
                          ],
                          "variable": [
                            {
                              "id": "fc9ffbee-d7d3-4500-8de6-a6bbfe1783a7",
                              "key": "deployment_name",
                              "value": "<string>",
                              "description": "(Required) The unique name of the deployment (e.g. \"happy-otter-123\"). This is the subdomain portion of the deployment URL at convex.cloud."
                            }
                          ]
                        },
                        "description": "Associates a custom domain with a Convex deployment. Supports two request destination types: convexCloud for routing to the function API (queries, mutations, actions), and convexSite for routing to HTTP action endpoints. Domain verification and DNS configuration is handled separately."
