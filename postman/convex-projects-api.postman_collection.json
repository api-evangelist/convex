                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"name\": \"<string>\",\n  \"team_id\": \"<long>\",\n  \"deployment_region\": \"aws-us-east-1\",\n  \"deployment_class\": \"s256\"\n}",
