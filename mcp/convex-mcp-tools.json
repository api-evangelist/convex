        "name": "start_convex_app",
        "title": "Start a Convex App",
        "description": "CALL THIS FIRST — before writing any files — whenever the user asks to build, scaffold, create, or start a new app, prototype, or backend and Convex is in play (they mentioned Convex, invoked the Convex tool/app, or want a reactive/full-stack TS/JS backend). Returns the exact `npm create convex@latest` scaffold command, a derived app slug, harness-specific notes, and the next step: call `get_runbook`. Skipping this and hand-rolling a Convex app is the most common mistake — it leads to anonymous throwaway backends, missing auth/JWT setup, and re-implemented components. This tool only returns guidance (it does not run commands), so calling it is cheap and safe; always start here.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "idea": {
              "type": "string",
              "minLength": 3,
              "description": "Free-form description of the app the user wants to build."
            },
            "template": {
              "type": "string",
              "enum": [
                "nextjs-convexauth-shadcn",
                "nextjs-shadcn",
                "nextjs-clerk-shadcn",
                "vite-react-shadcn",
                "vite-react-clerk-shadcn",
                "bare"
              ],
              "description": "create-convex template slug. Default: nextjs-convexauth-shadcn (zero-touch password auth, no email server)."
            },
            "harness": {
              "type": "string",
              "enum": [
                "claude-code",
                "codex",
                "cursor",
                "antigravity",
                "github-copilot",
                "conductor"
