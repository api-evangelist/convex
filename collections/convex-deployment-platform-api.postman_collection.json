    {
      "id": "f2b58ac8-986d-4c61-98bf-d40ae017e6af",
      "name": "EnvironmentVariables",
      "description": {
        "content": "Manage environment variables for a Convex deployment. Environment variables are key-value pairs accessible to backend functions at runtime via process.env. Changes to environment variables take effect after the next deployment push.",
        "type": "text/plain"
      },
      "item": [
