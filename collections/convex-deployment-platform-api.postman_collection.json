            "name": "List environment variables",
            "description": {
              "content": "Retrieves all environment variables configured for the deployment. Returns an array of key-value pairs representing the current environment variable configuration. Sensitive values are returned in full and should be handled securely. Authentication requires a deployment key, Team Access Token, or OAuth Application Token formatted as \"Convex {token}\" in the Authorization header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "list_environment_variables"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
