      },
      "item": [
        {
          "id": "5e0bb085-f842-4fc8-a220-67c35caf2dac",
          "name": "Create a team access token",
          "request": {
            "name": "Create a team access token",
            "description": {
              "content": "Creates a new Team Access Token for the specified team. Team Access Tokens are used to authenticate Management API requests and grant access to all projects and deployments within the team. The token value is only returned at creation time and should be stored securely.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "teams",
                ":team_id",
                "create_access_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "team_id",
                  "description": "(Required) The integer identifier of the Convex team. Available in the Convex dashboard when creating Team Access Tokens."
                },
                {
                  "description": "The deployment name found in the Convex dashboard or via the Management API. Each deployment has a unique subdomain under convex.cloud.",
                  "type": "any",
                  "value": "{{deploymentName}}",
                  "key": "deploymentName"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
