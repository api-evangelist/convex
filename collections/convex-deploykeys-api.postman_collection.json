    {
      "id": "03d98569-b656-4c6e-8378-af1238804f4c",
      "name": "DeployKeys",
      "description": {
        "content": "Create and manage deploy keys for CLI operations and CI/CD pipelines. Deploy keys authenticate the Convex CLI when pushing function code to a deployment.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2492ee79-4701-4e32-9501-7263dc0f050a",
          "name": "Create a deploy key",
          "request": {
            "name": "Create a deploy key",
            "description": {
              "content": "Creates a new deploy key for a project, scoped to a specific deployment. Deploy keys are used by the Convex CLI and CI/CD pipelines to push function code to deployments. Keys can be standard or preview keys for Vercel-style preview deployments.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "deployments",
                "create_deploy_key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "project_id",
                  "description": "(Required) The integer identifier of the Convex project. Obtainable via the List Projects endpoint or assigned during project creation."
                },
                {
                  "description": "The deployment name found in the Convex dashboard or via the Management API. Each deployment has a unique subdomain under convex.cloud.",
                  "type": "any",
                  "value": "{{deploymentName}}",
                  "key": "deploymentName"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deployment_name\": \"<string>\",\n  \"key_name\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
