    {
      "id": "fb9f1d5d-4bda-43b1-addf-2611b1985055",
      "name": "Deployments",
      "description": {
        "content": "Create, list, retrieve, update, and delete Convex cloud and local deployments. Deployments are the runtime environments where Convex backend functions execute.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "961ec9f6-d9f9-40dc-825c-967d99ccc1ba",
          "name": "Create a cloud deployment",
          "request": {
            "name": "Create a cloud deployment",
            "description": {
              "content": "Creates a new cloud deployment within a project in the specified region and deployment class. Cloud deployments run on Convex-managed infrastructure and are accessible via a public URL. Supports dev, prod, preview, and custom deployment types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "deployments",
                "create_cloud"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "project_id",
                  "description": "(Required) The integer identifier of the Convex project. Obtainable via the List Projects endpoint or assigned during project creation."
                },
                {
                  "description": "The deployment name found in the Convex dashboard or via the Management API. Each deployment has a unique subdomain under convex.cloud.",
                  "type": "any",
                  "value": "{{deploymentName}}",
                  "key": "deploymentName"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
