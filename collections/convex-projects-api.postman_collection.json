    {
      "id": "27cb2e27-7d72-4499-8ff4-6fe24159cb95",
      "name": "Projects",
      "description": {
        "content": "Create, list, retrieve, and delete Convex projects within a team. Projects group deployments and serve as the top-level organizational unit for Convex applications.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3352c3e4-412e-4ef6-9a70-3e232b3eb059",
          "name": "Create a new project",
          "request": {
            "name": "Create a new project",
            "description": {
              "content": "Provisions a new Convex project within the specified team. Optionally creates an initial production deployment in the specified cloud region and deployment class. Returns the new project's ID and slug along with details of any provisioned deployment.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "teams",
                ":team_id",
                "create_project"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "team_id",
                  "description": "(Required) The integer identifier of the Convex team. Available in the Convex dashboard when creating Team Access Tokens."
                },
                {
                  "description": "The deployment name found in the Convex dashboard or via the Management API. Each deployment has a unique subdomain under convex.cloud.",
                  "type": "any",
                  "value": "{{deploymentName}}",
                  "key": "deploymentName"
                }
              ]
            },
