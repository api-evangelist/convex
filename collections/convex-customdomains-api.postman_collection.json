      "id": "ceb39e16-fe9f-442d-98b4-6b767ea9e1ef",
      "name": "CustomDomains",
      "description": {
        "content": "Configure custom domain names for Convex deployments. Supports both convexCloud (function API) and convexSite (HTTP actions) request destinations.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "49fae9cc-3ed4-4561-b777-b01abb49351f",
          "name": "Create a custom domain",
          "request": {
            "name": "Create a custom domain",
            "description": {
              "content": "Associates a custom domain with a Convex deployment. Supports two request destination types: convexCloud for routing to the function API (queries, mutations, actions), and convexSite for routing to HTTP action endpoints. Domain verification and DNS configuration is handled separately.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "deployments",
                ":deployment_name",
                "custom_domains",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "deployment_name",
                  "description": "(Required) The unique name of the deployment (e.g. \"happy-otter-123\"). This is the subdomain portion of the deployment URL at convex.cloud."
                },
                {
                  "description": "The deployment name found in the Convex dashboard or via the Management API. Each deployment has a unique subdomain under convex.cloud.",
                  "type": "any",
                  "value": "{{deploymentName}}",
                  "key": "deploymentName"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"<string>\",\n  \"request_destination\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
